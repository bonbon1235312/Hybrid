{
  "name": "hybrid-league-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.mjs",
    "commands:register": "tsx src/discord/register-commands.ts",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint . --max-warnings=0",
    "migrate": "tsx src/platform/migrate.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "mysql2": "^3.23.3",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "testcontainers": "^12.1.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
